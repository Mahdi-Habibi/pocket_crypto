TELEGRAM_BOT_TOKEN=your-telegram-token
# Enable webhook mode (required for Vercel/serverless)
USE_WEBHOOK=true
# Base URL for your webhook (must match the Vercel production domain)
WEBHOOK_BASE_URL=https://cryptoinyourpocketbot.vercel.app
# Path for the webhook endpoint. Default is /api/webhook (Vercel)
WEBHOOK_PATH=/api/webhook
# Local port for webhook server (used only when running bot.py directly)
PORT=8080

